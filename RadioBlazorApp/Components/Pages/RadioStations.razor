@page "/radio-stations"
@using RadioBlazorApp.Services
@inject MqttClientService MqttService
@implements IDisposable

<PageTitle>DAB+ Radio Sender</PageTitle>

<h1>DAB+ Radio Sender</h1>

<div class="connection-panel mb-4">
    <h3>MQTT Verbindung</h3>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Broker Adresse:</label>
            <input type="text" class="form-control" @bind="brokerAddress" disabled="@MqttService.IsConnected" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Port:</label>
            <input type="number" class="form-control" @bind="brokerPort" disabled="@MqttService.IsConnected" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Request Topic:</label>
            <input type="text" class="form-control" @bind="requestTopic" disabled="@MqttService.IsConnected" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Response Topic:</label>
            <input type="text" class="form-control" @bind="responseTopic" disabled="@MqttService.IsConnected" />
        </div>
    </div>
    <div class="mt-3">
        @if (!MqttService.IsConnected)
        {
            <button class="btn btn-primary" @onclick="ConnectToMqtt">Verbinden</button>
        }
        else
        {
            <button class="btn btn-success" @onclick="GetStations">Sender abrufen</button>
            <button class="btn btn-danger ms-2" @onclick="DisconnectFromMqtt">Trennen</button>
        }
    </div>
</div>

<div class="status-panel mb-4">
    <h3>Status</h3>
    <div class="alert @(MqttService.IsConnected ? "alert-success" : "alert-secondary")">
        @statusMessage
    </div>
</div>

@if (stations.Any())
{
    <div class="stations-panel">
        <h3>Gefundene Sender (@stations.Count)</h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Frequenz</th>
                        <th>Signalstärke</th>
                        <th>Genre</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var station in stations.OrderByDescending(s => s.SignalStrength))
                    {
                        <tr>
                            <td><strong>@station.Name</strong></td>
                            <td>@station.Frequency</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                        <div class="progress-bar @GetSignalColorClass(station.SignalStrength)" 
                                             role="progressbar" 
                                             style="width: @station.SignalStrength%"
                                             aria-valuenow="@station.SignalStrength" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <span>@station.SignalStrength%</span>
                                </div>
                            </td>
                            <td>@station.Genre</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private string brokerAddress = "localhost";
    private int brokerPort = 1883;
    private string requestTopic = "radio/command";
    private string responseTopic = "radio/stations";
    private string statusMessage = "Nicht verbunden";
    private List<RadioStation> stations = new();

    protected override void OnInitialized()
    {
        MqttService.OnStationsReceived += HandleStationsReceived;
        MqttService.OnStatusChanged += HandleStatusChanged;
    }

    private async Task ConnectToMqtt()
    {
        try
        {
            await MqttService.ConnectAsync(brokerAddress, brokerPort, requestTopic, responseTopic);
        }
        catch (Exception ex)
        {
            statusMessage = $"Verbindungsfehler: {ex.Message}";
        }
    }

    private async Task DisconnectFromMqtt()
    {
        await MqttService.DisconnectAsync();
        stations.Clear();
    }

    private async Task GetStations()
    {
        await MqttService.SendGetStationsCommandAsync();
    }

    private void HandleStationsReceived(List<RadioStation> receivedStations)
    {
        stations = receivedStations;
        InvokeAsync(StateHasChanged);
    }

    private void HandleStatusChanged(string message)
    {
        statusMessage = message;
        InvokeAsync(StateHasChanged);
    }

    private string GetSignalColorClass(int signalStrength)
    {
        return signalStrength switch
        {
            >= 75 => "bg-success",
            >= 50 => "bg-warning",
            _ => "bg-danger"
        };
    }

    public void Dispose()
    {
        MqttService.OnStationsReceived -= HandleStationsReceived;
        MqttService.OnStatusChanged -= HandleStatusChanged;
    }
}

<style>
    .connection-panel, .status-panel, .stations-panel {
        padding: 20px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background-color: #f8f9fa;
    }

    .connection-panel h3, .status-panel h3, .stations-panel h3 {
        margin-bottom: 15px;
        color: #495057;
    }

    .table {
        background-color: white;
    }

    .progress {
        background-color: #e9ecef;
    }
</style>
